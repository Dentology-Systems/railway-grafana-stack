ARG VERSION=v3.2.1

FROM prom/prometheus:${VERSION}

# Copy the prom.yml configuration file to the container
COPY prom.yml /etc/prometheus/prom.yml

# Command to run Prometheus
# --web.enable-remote-write-receiver: accept Tempo's generated span metrics at /api/v1/write
# --web.listen-address=[::]:9090: bind IPv6 so the service is reachable over Railway's private network
# --storage.tsdb.no-lockfile: avoid the TSDB lock deadlock during Railway's overlapping
#   redeploys (new container starts while the old still holds the volume lock)
CMD ["--config.file=/etc/prometheus/prom.yml", "--storage.tsdb.path=/prometheus", "--web.enable-remote-write-receiver", "--web.listen-address=[::]:9090", "--storage.tsdb.no-lockfile"]