{
	admin off
	auto_https off
	persist_config off
}

# Public, authenticated log ingress. Railway provides $PORT. Forwards to Loki's
# push/query API over the (IPv6) private network. Caddy/Go re-resolves DNS and
# retries dead connections, so this self-heals across Loki redeploys instead of
# getting stuck the way a hand-rolled fetch loop does.
:{$PORT:8080} {
	# Railway healthcheck target
	handle /health {
		respond "ok" 200
	}

	# Require the shared API key on EVERY path (the old Bun proxy only checked
	# /loki/*, /api/* and /, leaving other paths unauthenticated).
	@authorized header X-API-Key {$API_KEY}
	handle @authorized {
		reverse_proxy {$LOKI_INTERNAL_URL:http://loki.railway.internal:3100} {
			# Fail fast on a bad dial and retry rather than hang.
			lb_try_duration 5s
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	# No / wrong key
	respond "Unauthorized" 401
}
