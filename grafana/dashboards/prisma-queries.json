{
  "uid": "prisma-queries",
  "title": "Prisma Queries",
  "tags": ["prisma", "dentology", "spanmetrics"],
  "editable": true,
  "schemaVersion": 39,
  "timezone": "",
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "model",
        "label": "Prisma model",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
        "definition": "label_values(traces_spanmetrics_calls_total{span_name=\"prisma:client:operation\"}, model)",
        "query": "label_values(traces_spanmetrics_calls_total{span_name=\"prisma:client:operation\"}, model)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Prisma operations (avg/h over range)",
      "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
          "expr": "3600 * sum(rate(traces_spanmetrics_calls_total{span_name=\"prisma:client:operation\", model=~\"${model:regex}\"}[$__range]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "p95 operation latency (over range)",
      "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{span_name=\"prisma:client:operation\", model=~\"${model:regex}\"}[$__range])))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p99 operation latency (over range)",
      "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(traces_spanmetrics_latency_bucket{span_name=\"prisma:client:operation\", model=~\"${model:regex}\"}[$__range])))"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Slowest Prisma operations (over selected range)",
      "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 11 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "align": "auto", "filterable": true } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Calls" },
            "properties": [{ "id": "unit", "value": "short" }, { "id": "decimals", "value": 0 }]
          },
          {
            "matcher": { "id": "byName", "options": "p50" },
            "properties": [{ "id": "unit", "value": "s" }, { "id": "decimals", "value": 3 }]
          },
          {
            "matcher": { "id": "byName", "options": "p95" },
            "properties": [{ "id": "unit", "value": "s" }, { "id": "decimals", "value": 3 }, { "id": "custom.cellOptions", "value": { "type": "color-text" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "red", "value": 2 }] } }]
          },
          {
            "matcher": { "id": "byName", "options": "p99" },
            "properties": [{ "id": "unit", "value": "s" }, { "id": "decimals", "value": 3 }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "p95", "desc": true }]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
          "expr": "sum by (operation) (label_join(increase(traces_spanmetrics_calls_total{span_name=\"prisma:client:operation\", model=~\"${model:regex}\"}[$__range]), \"operation\", \".\", \"model\", \"method\"))"
        },
        {
          "refId": "B",
          "format": "table",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le, operation) (label_join(rate(traces_spanmetrics_latency_bucket{span_name=\"prisma:client:operation\", model=~\"${model:regex}\"}[$__range]), \"operation\", \".\", \"model\", \"method\")))"
        },
        {
          "refId": "C",
          "format": "table",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, operation) (label_join(rate(traces_spanmetrics_latency_bucket{span_name=\"prisma:client:operation\", model=~\"${model:regex}\"}[$__range]), \"operation\", \".\", \"model\", \"method\")))"
        },
        {
          "refId": "D",
          "format": "table",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le, operation) (label_join(rate(traces_spanmetrics_latency_bucket{span_name=\"prisma:client:operation\", model=~\"${model:regex}\"}[$__range]), \"operation\", \".\", \"model\", \"method\")))"
        }
      ],
      "transformations": [
        { "id": "joinByField", "options": { "byField": "operation", "mode": "outer" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true
            },
            "renameByName": {
              "operation": "Operation",
              "Value #A": "Calls",
              "Value #B": "p50",
              "Value #C": "p95",
              "Value #D": "p99"
            },
            "indexByName": {
              "operation": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "p95 operation latency by operation",
      "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
      "gridPos": { "x": 0, "y": 15, "w": 12, "h": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "auto",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, operation) (label_join(rate(traces_spanmetrics_latency_bucket{span_name=\"prisma:client:operation\", model=~\"${model:regex}\"}[$__rate_interval]), \"operation\", \".\", \"model\", \"method\")))",
          "legendFormat": "{{operation}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Operation rate by operation (req/h)",
      "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
      "gridPos": { "x": 12, "y": 15, "w": 12, "h": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "auto",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
          "expr": "3600 * sum by (operation) (label_join(rate(traces_spanmetrics_calls_total{span_name=\"prisma:client:operation\", model=~\"${model:regex}\"}[$__rate_interval]), \"operation\", \".\", \"model\", \"method\"))",
          "legendFormat": "{{operation}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "SQL execution latency (prisma:client:db_query, all queries)",
      "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "auto",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(traces_spanmetrics_latency_bucket{span_name=\"prisma:client:db_query\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{span_name=\"prisma:client:db_query\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(traces_spanmetrics_latency_bucket{span_name=\"prisma:client:db_query\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    }
  ]
}
